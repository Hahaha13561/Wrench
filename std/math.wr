print("floor(3.9)          : "); print_float(floor(3.9)); print(" (should be 3.0)\n");
print("ceil(-3.9)          : "); print_float(ceil(-3.9)); print(" (should be -3.0)\n");
print("round(4.5)          : "); print_float(round(4.5)); print(" (should be 5.0)\n");
print("clamp(150, 0, 100)  : "); print_int(clamp(150, 0, 100)); print(" (is limited with 100)\n\n");

print("--- 5. RANDOM NUMBERS (Auto-Seeded) ---\n");
print("Die Roll (1-6)     : "); print_int(rand_range(1, 6)); print("\n");
print("Die Roll (1-6)     : "); print_int(rand_range(1, 6)); print("\n");
print("Random Float(0-1) : "); print_float(rand_float()); print("\n\n");

print("--- 6. GEOMETRY AND DISTANCE ---\n");
print("Hypot(3.0, 4.0)     : "); print_float(hypot(3.0, 4.0)); print(" (should be 5.0)\n");
print("2D Distance (0,0->6,8): "); print_float(dist2d(0.0, 0.0, 6.0, 8.0)); print(" (should be 10.0)\n");
print("Manhattan (0,0->3,4): "); print_int(manhattan(0, 0, 3, 4)); print(" (should be 7)\n\n");

print("        ALL TESTS COMPLETE         \n");
