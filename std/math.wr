print("sqrt(144.0)         : "); print_float(sqrt(144.0)); print(" (should be 12.0)\n");
print("cbrt(-27.0)         : "); print_float(cbrt(-27.0)); print(" (should be -3.0)\n");
print("ln(E^5)             : "); print_float(log(pow(E, 5.0))); print(" (should be 5.0)\n");
print("log10(1000.0)       : "); print_float(log10(1000.0)); print(" (should be 3.0)\n\n");

print("--- 4. ROUNDING AND CLAMP ---\n");
