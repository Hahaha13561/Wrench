/# 
include "std/time.wr";

print("--- EPOCH AND UTC TIME TEST ---\n");
var ep = now();
print("Current Epoch Second: ");
print(ep);
print("\n");

var utc = now_utc();
print("UTC Date / Time: ");
print(utc[0]); print("-"); 
print(utc[1]); print("-"); 
print(utc[2]); print(" "); 
print(utc[3]); print(":"); 
print(utc[4]); print(":"); 
print(utc[5]); print("\n\n");

print("--- SLEEP TEST ---\n");
var t1 = ticks();
print("Waiting 1000 ms (1 second)...\n");
sleep(1000);
var t2 = ticks();

var gecen = t2 - t1;
print("Time passed (ms): ");
print(gecen); // 1000 ms civarında olmalı
print("\n\n");

print("--- BENCHMARK (MEASURE) TEST ---\n");
var agir_islem = anfunc() {
    var i = 0;
    var toplam = 0;
    while (i < 5000000) {
        toplam += i;
        i += 1;
    }
};

var sure = measure(agir_islem);
print("5 Million Loop Runtime (ms): ");
print(sure);
print("\n\n--- TEST COMPLETE ---\n");
#/