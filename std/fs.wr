/#  WRENCH STANDARD LIBRARY
    stf/fs.wr
    File System Library
#/

include "std/collections.wr";

class File {
    int fd;
    int size;
    var content;

    define init(str file_path) -> unit {
        // Parameters: 2 (rax), path (rdi), 0 O_RDONLY (rsi), 0 mode (rdx)
        this.fd = syscall(2, file_path, 0, 0) cast int;

        if (this.fd < 0) {
            print("Critical Error: File couldn't open -> ");
            print(file_path);
            print("\n");
            trigger 1;
        }

        // 2. Find the filesize (sys_lseek = Syscall 8)
        // SEEK_END = 2 
        this.size = syscall(8, this.fd, 0, 2) cast int;

        syscall(8, this.fd, 0, 0);
        
        var buf = alloc(this.size + 1) cast str;
        syscall(0, this.fd, buf, this.size);

        buf[this.size] = 0 cast char;
        this.content = buf;
    }

    define read_all() -> str {
        return this.content cast str;
    }

    define close() -> unit {
        if (this.fd >= 0) {
            syscall(3, this.fd);
            this.fd = -1;
        }
        if (this.content =! null) {
            delete this.content;
            this.content = null;
        }
    }
}

define write_file(str file_path, str content) -> bool {
    // O_WRONLY (1) | O_CREAT (64) | O_TRUNC (512) = 577
    // File permissions (mode) = 0644 octal = 420 decimal
    var fd = syscall(2, file_path, 577, 420) cast int;
    if (fd < 0) {
        return false;
    }

    var length = 0;
    while (content[length] != 0 cast char) {
        length += 1;
    }

    syscall(1, fd, content, length); // sys_write
    syscall(3, fd); // sys_close
    return true;
}

define append_file(str file_path, str content) -> bool {
    // O_WRONLY (1) | O_CREAT (64) | O_APPEND (1024) = 1089
    var fd = syscall(2, file_path, 1089, 420) cast int;
    if (fd < 0) {
        return false;
    }

    var length = 0;
    while (content[length] != 0 cast char) {
        length += 1;
    }
    
    syscall(1, fd, content, length); // sys_write
    syscall(3, fd); // sys_close
    return true;
}

define delete_file(str file_path) -> bool {
    // sys_unlink = 87
    var res = syscall(87, file_path) cast int;
    if (res < 0) {
        return false;
    }
    return true;
}

define dir_list(str dir_path) -> List {
    var file_list = new List();
    // O_RDONLY (0) | O_DIRECTORY (65536) = 65536
    var fd = syscall(2, dir_path, 65536, 0) cast int;
    if (fd < 0) {
        print("FS Error: Could not open directory\n");
        return file_list;
    } 

    var buf_size = 1024;
    var buffer = alloc(buf_size) cast str;

    while (true) {
        // sys_getdents = 78, sys_getdents64 = 217
        var bread = syscall(217, fd, buffer, buf_size) cast int;
        if (bread <= 0) {
            break;
        }

        var bpos = 0;
        while (bpos < bread) {
            var b1 = buffer[bpos + 16] cast int;
            var b2 = buffer[bpos + 17] cast int;
            var reclen = b1 + (b2 * 256);
            var name_start = bpos + 19;

            var name_len = 0;
            while (buffer[name_start + name_len] != 0 cast char) {
                name_len += 1;
            }

            if (name_len > 0) {
                var file_name = alloc(name_len + 1) cast str;
                var k = 0;
                while (k < name_len) {
                    file_name[k] = buffer[name_start + k];
                    k += 1;
                }

                file_name[name_len] = 0 cast char;

                var skip = false;
                if (name_len =? 1) {
                    if (file_name[0] =? "." cast char){
                        skip = true;
                    }
                }
                if (name_len =? 2) {
                    if (file_name[0] =? "." cast char) {
                        if (file_name[1] =? "." cast char) {
                            skip = true;
                        }
                    }
                }

                if (skip =? false) {
                    file_list.push(file_name);
                } 
                else {
                    delete file_name;
                }
            }

            bpos += reclen;

        }
    }

    delete buffer;
    syscall(3, fd);
    return file_list;
}