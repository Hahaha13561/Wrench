include "std/collections.wr";
include "std/fs.wr";

print("--- FILE SYSTEM (FS) LIBRARY TEST ---\n\n");

var test_dosyasi = "wrench_test.txt";

print("[*] Creating and writing to file...\n");
var w_res = write_file(test_dosyasi, "Hello from Wrench Compiler!\n");
if (w_res) { print(" -> Write OK.\n"); }

print("[*] Appending to file...\n");
var a_res = append_file(test_dosyasi, "This line was appended.\n");
if (a_res) { print(" -> Append OK.\n"); }

print("[*] Reading file contents...\n");
var dosya = new File(test_dosyasi);
print("--- FILE START ---\n");
print(dosya.read());
print("--- FILE END ---\n");
dosya.close();

print("\n[*] Listing current directory contents...\n");
List files = dir_list(".");
var count = files.length;
var i = 0;

while (i < count) {
    var f_name = files.get(i) cast str;
    
    print(" - ");
    print(f_name);
    print("\n");
    
    if (f_name =? test_dosyasi) {
        print(" -> Found our test file! Deleting it...\n");
        delete_file(test_dosyasi);
    }
    i += 1;
}

print("\n--- ALL FS TESTS COMPLETED ---\n");
