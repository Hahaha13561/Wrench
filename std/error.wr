print("--- SIGSEGV (SEGFAULT) CATCH TEST ---\n\n");

print("[1] Program is running...\n");

attempt {
    print("[2] In an attempt. Creating Segfault...\n");
    
    var yasakli_adres = 1193046; // 0x123456 in base 10
    var hedef_pointer = ptr_to(yasakli_adres);
    
    var okunan = get_mem(yasakli_adres, 0); 
    
    print("How tf did this even got printed");
} exclude {
    print("\n--- SEGFAULT CAUGHT ---\n");
    print("Compromised Memory Address (Hex): ");
    
    
    syscall(0, err, 0);
    print_hex(err);     
    print("\n\n");
}

print("[3] Program did not crash and is still running...\n");
print("--- TEST COMPLETE ---\n");
// ----------------------------------------
include "std/error.wr";

print("--- ERROR MANAGEMENT SYSTEM TEST ---\n\n");

print("[1] Creating Warning...\n");
var uyari = new Warning("Bellek kullanim orani %85'e ulasti!");
uyari.warn();
print("Warning Code (Should be 0): ");
print(uyari.code);
print("\n\n");

print("[2] Creating Exception...\n");
var hata = new Exception("Index Out Of Bounds", 99);
hata.print_err();
print("\n");

print("[3] Creating FatalError...\n");

var simule_adres = 2147441200; 

var kritik_hata = new FatalError("Segmentation Fault (SIGSEGV)", 139, simule_adres);
kritik_hata.print_fatal();
print("\n");

print("[4] Inheritance and Upcast Test...\n");
BaseException ata_hata = kritik_hata; 

print("Reading Message on Parent Class: ");
print(ata_hata.message);
print("\nReading Error Code on Parent Class: ");
print(ata_hata.code);
print("\n");

print("[5] Attempt/Exclude Test...\n");

attempt {
    print(" -> Triggering Exception...\n");
    trigger hata.code; 
    print(" -> This line should never print\n");
} exclude {
    print(" -> Caught Exclusion, Error Code: ");
    print(err);
    print("\n -> Error Object Message: ");
    print(hata.message);
    print("\n");
} final {
    print(" -> Final Running...\n");
    free(uyari);
    free(hata);
    free(kritik_hata);
}

print("\n--- TEST COMPLETE --- \n");
// ----------------------------------------
include "std/error.wr";

print("--- FATAL ERROR LIBRARY TEST ---\n\n");

print("[1] SystemExit...\n");
var sys_exit = new SystemExit("Program closed normally.", 0);
print(" -> Message: ");
print(sys_exit.message);
print("\n -> Exit Code (should be 0): ");
print(sys_exit.code);
print("\n\n");

print("[2] KeyboardInterrupt....\n");
var sig_int = new KeyboardInterrupt("");
print(" -> Message: ");
print(sig_int.message);
print("\n -> Signal Code (Should be 130): ");
print(sig_int.code);
print("\n\n");

print("[3] GeneratorExit...\n");
var gen_exit = new GeneratorExit("Generator Exit.");
print(" -> Message: ");
print(gen_exit.message);
print("\n -> Core Code (Should be 1000): ");
print(gen_exit.code);
print("\n\n");

// [4] MEMORY ERROR TESTİ (Bellek Adresiyle Birlikte)
print("[4] MemoryError...\n");
var heap_fail_addr = 0x000000007fff8800; // Simüle edilmiş Heap taşma adresi
var mem_err = new MemoryError("Out of Heap Memory (ENOMEM), failed alloc().", heap_fail_addr);
print(" -> Message: ");
print(mem_err.message);
print("\n -> Error Code (should be 12): ");
print(mem_err.code);
print("\n -> Failed Allocation Address: ");
print_hex(mem_err.fault_addr);
print("\n\n");

// [5] SYSTEM ERROR TESTİ
print("[5] SystemError...\n");
var os_err = new SystemError("System Error.", 5);
print(" -> Message: ");
print(os_err.message);
print("\n -> OS Error Code (should be 5): ");
print(os_err.code);
print("\n\n");

print("[6] RecursionError and Upcast (Polymorphizm)...\n");
var stack_limit = 0x0000000010000000;
var rec_err = new RecursionError("Stack Overflow!", stack_limit);

FatalError ata_fatal = rec_err;
BaseException ata_base = rec_err;

print(" -> Parent Class (BaseException) Message: ");
print(ata_base.message);
print("\n -> Parent Class (FatalError) Error Code (should be 139): ");
print(ata_fatal.code);
print("\n -> Parent Class (FatalError) Stack Address: ");
print_hex(ata_fatal.fault_addr);
print("\n\n");

print("[7]MemoryError Exclusion...\n");

attempt {
    print(" -> Triggering MemoryError...\n");
    trigger mem_err.code; 
    print(" -> This line should not be printed mofo\n");
} exclude {
    print(" -> Exclude Caught the Error. Caught Code: ");
    print(err);
} final {
    print(" -> Final: Clearing RAM...\n");
    free(sys_exit);
    free(sig_int);
    free(gen_exit);
    free(mem_err);
    free(os_err);
    free(rec_err);
}

print("\n--- TEST COMPLETE --- \n");
