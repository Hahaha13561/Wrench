/# WRENCH STANDARD LIBRARY
    std/sys.wr
    System Library
#/
include "std/collections.wr";

define args() -> List {
    var args_list = new List();
    var argc = sys_argc();
    var i = 0;

    while (i < argc) {
        args_list.push(sys_argv(i) cast str);
        i += 1;
    }

    return args_list;
}

define execute(str program, List cmd_args) -> int {
    var pid = syscall(57) cast int;

    if (pid =? 0) {
        var exec_len = cmd_args.length;

        var argv_ptr = alloc((exec_len+1) * 8) cast int[];

        var i = 0;

        while (i < exec_len) {
            argv_ptr[i] = cmd_args.get(i) cast int;
            i += 1;
        }

        argv_ptr[exec_len] = 0;

        syscall(59, program, argv_ptr, 0);
        
        delete argv_ptr;

        print("Execve Error: Failed to execute process\n");
        exit(1);
    }
    else {
        syscall(61, pid, 0, 0, 0);
    }
    return 0;
}

class SysModule {
    List argv;
    int stdin;
    int stdout;
    int stderr;
    str platform;

    define init() -> unit {
        this.stdin = 0;
        this.stdout = 1;
        this.stderr = 2;
        this.platform = "linux";

        this.argv = args();
    }

    define quit(int code) -> unit {
        exit(code);
    }

    define setrecursionlimit(int limit_bytes) -> unit {
        var rlim = alloc(16) cast int[];
        rlim[0] = limit_bytes;
        rlim[1] = limit_bytes;
        syscall(160, 3, rlim);
        delete rlim;
    }

    define getsizeof(var obj) -> int {
        attempt {
            var size = len(obj) * 8;
            return size;
        }
        exclude {
            return 8;
        }
    }

    define execute(str program, List cmd_args) -> int {
        execute(program, cmd_args);
    }

    define destroy() -> unit {
        if (this.argv != null) {
            this.argv.destroy();
            delete this.argv;
        }
    }
}

var sys = new SysModule();