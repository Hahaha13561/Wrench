/# WRENCH STANDARD LIBRARY
    std/sys.wr
    System Library
#/
include "std/collections.wr";

define args() -> List {
    var args_list = new List();
    var argc = sys_argc();
    var i = 0;

    while (i < argc) {
        args_list.push(sys_argv(i) cast str);
        i += 1;
    }

    return args_list;
}

define execute(str program, List cmd_args) -> int {
    var pid = syscall(57) cast int;

    if (pid =? 0) {
        var len = cmd_args.length;

        var argv_ptr = alloc((len+1) * 8);

        var i = 0;

        while (i < len) {
            var str_ptr = cmd_args.get(i) cast int;
            var offset  = i * 8;
            set_mem(argv_ptr, offset, str_ptr);
            i += 1;
        }

        var null_offset = len * 8;
        set_mem(argv_ptr, null_offset, 0);

        syscall(59, program, argv_ptr, 0);

        print("Execve Error: Failed to execute process\n");
        exit(1);
    }
    else {
        syscall(61, pid, 0, 0, 0);
    }
    return 0;
}

class SysModule {
    List argv;
    int stdin;
    int stdout;
    int stderr;
    str platform;

    define init() {
        this.stdin = 0;
        this.stdout = 1;
        this.stderr = 2;
        this.platform = "linux";

        this.argv = args();
    }

    define exit(int code) {
        syscall(60, code, 0, 0, 0, 0, 0);
    }

    define setrecursionlimit(int limit) {
        print("[Warning]: Recursion limit is determined by your OS stack size.\n"); //That's not what it's supposed to be i assume..
    }

    define getsizeof(var obj) -> int {
        attempt {
            var size = len(obj) * 8;
            return size;
        }
        exclude {
            return 8;
        }
    }

    define execute(str program, List cmd_args) {
        execute(program, cmd_args);
    }

    define destroy() {
        this.argv.destroy();
        delete this.argv;
    }
}

var sys = new SysModule();