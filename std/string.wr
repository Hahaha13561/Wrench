/# WRENCH STANDARD LIBRARY
    std/string.wr
    String Library
#/

include "std/collections.wr";

define str_len(str text) -> int {
    var i = 0;
    while (text[i] != 0 cast char) {
        i += 1;
    }
    return i;
}

define substring(str text, int start, int end) -> str {
    var length = end - start;
    str result = alloc(length + 1) cast str;

    var i = 0;
    while (i < length) {
        result[i] = text[start + i];
        i += 1;
    }
    result[length] = 0 cast char;
    return result;
}

define uppercase(str text) -> str {
    var length = str_len(text);
    str result = alloc(length+1) cast str;

    var i = 0;
    while (i < length) {
        var c = text[i] cast int;
    
    // ASCII 'a' = 97, 'z' = 122
        if (c => 97 and c <= 122) {
            c -= 32;
        }

        result[i] = c cast char;
        i += 1;
    }    
    result[length] = 0 cast char;
    return result;
}

define lowercase(str text) -> str {
    var length = str_len(text);
    str result = alloc(length + 1) cast str;

    var i = 0;
    while (i < length) {
        var c = text[i] cast int;

        // ASCII 'A' = 65, 'Z' = 90
        if ( c => 65 and c <= 90) {
            c += 32;
        }

        result[i] = c cast char;
        i += 1;
    }
    result[length] = 0 cast char;
    return result;
}

define split(str text, char delimiter) -> var {
    var length = str_len(text);
    var count = 1;
    var i = 0;

    while (i < length) {
        if (text[i] =? delimiter) {
            count += 1;
        }
        i += 1;
    }

    var list = alloc(count * 8);
    var part_index = 0;
    var start = 0;
    i = 0;

    while (i <= length) {
        if (text[i]  =? delimiter or text[i] =? 0 cast char) {
            list[part_index] = substring(text, start, i);
            part_index += 1;
            start = i + 1;
        }
        i += 1;
    }

    return list;
}

define starts_with(str text, str prefix) -> bool {
    var p_len = str_len(prefix);
    var t_len = str_len(text);
    if (p_len > t_len) {
        return false;
    }
    var i = 0;
    while (i < p_len) {
        if (text[i] != prefix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

define ends_with(str text, str suffix) -> bool {
    var s_len = str_len(suffix);
    var t_len = str_len(text);
    if (s_len > t_len) {
        return false;
    }
    var start = t_len - s_len;
    var i = 0;
    while (i < s_len) {
        if (text[start + i] != suffix[i]) {
            return false;
        }
        i += 1;
    }
    return true;
}

define trim(str text) -> str {
    var t_len = str_len(text);
    var start = 0;
    while (start < t_len and (text[start] =? 32 cast char or text[start] =? 9 cast char or text[start] =? 10 cast char)) {
        start += 1;
    }
    var end = t_len;
    while (end > start and (text[end - 1] =? 32 cast char or text[end - 1] =? 9 cast char or text[end - 1] =? 10 cast char)) {
        end -= 1;
    }
    return substring(text, start, end);
}

define parse_int(str text) -> int {
    return text cast int;
}

define to_string(int number) -> str {
    return number cast str;
}

define concat(str left, str right) -> str {
    return left + right;
}