/# WRENCH STANDARD LIBRARY
    std/regex.wr
    Regular Expressions Library
#/

include "std/collections.wr";
include "std/string.wr";

class RegexPattern {
    str raw_pattern;

    define init(str pattern) -> unit {
        this.raw_pattern = pattern;
    }
}

define compile(str pattern) -> RegexPattern {
    return new RegexPattern(pattern);
}

define match(str pattern, str text, bool is_wildcard) -> str {
    var pat_len = str_len(pattern);
    var text_len = str_len(text);

    if (pat_len > text_len) {
        return null;
    }

    var i = 0;
    while (i < pat_len) {
        var char_match = (is_wildcard and pattern[i] =? "." cast char) or (pattern[i] =? text[i]);
        if (!char_match) {
            return null;
        }
        i += 1;
    }

    return substring(text, 0, pat_len);
}

define finditer(str pattern, str text, bool is_wildcard) -> List {
    var results = new List();
    var pat_len = str_len(pattern);
    var text_len = str_len(text);

    if (pat_len =? 0) {
        return results;
    }

    var i = 0;
    while (i <= (text_len - pat_len)) {
        var j = 0;
        var is_match = true;

        while (j < pat_len) {
            var char_match = (is_wildcard and pattern[j] =? "." cast char) or (pattern[j] =? text[i + j]);
            if (!char_match) {
                is_match = false;
                break;
            }
            j += 1;
        }

        if (is_match =? true) {
            var match_str = substring(text, i, i + pat_len);
            results.push(match_str);
            i += pat_len;
            goon;
        }
        i += 1;
    }

    return results;
}

define re_split(str pattern, str text, bool is_wildcard) -> List {
    var results = new List();
    var pat_len = str_len(pattern);
    var text_len = str_len(text);

    if (pat_len =? 0) {
        results.push(text);
        return results;
    }
    
    var start = 0;
    var i = 0;

    while (i <= (text_len - pat_len)) {
        var j = 0;
        var is_match = true;

        while (j < pat_len) {
            var char_match = (is_wildcard and pattern[j] =? "." cast char) or (pattern[j] =? text[i + j]);
            if (!char_match) {
                is_match = false;
                break;
            }
            j += 1;
        }

        if (is_match =? true) {
            var part = substring(text, start, i);
            results.push(part);
            i += pat_len;
            start = i;
            goon;
        }
        i += 1;
    }

    var last_part = substring(text, start, text_len);
    results.push(last_part);

    return results;
}

define sub(str pattern, str repl, str text, bool is_wildcard) -> str {
    List parts = re_split(pattern, text, is_wildcard) cast List;
    var parts_len = parts.length;
    if (parts_len =? 0) {
        parts.destroy();
        delete parts;
        var empty_str = alloc(1) cast str;
        empty_str[0] = 0 cast char;
        return empty_str;
    }

    var repl_len = str_len(repl);
    var total_len = 0;
    var i = 0;
    
    while (i < parts_len) {
        var part = parts.get(i) cast str;
        total_len += str_len(part);
        if (i <(parts_len - 1)) {
            total_len += repl_len;
        }
        i += 1;
    }

    var buf = alloc(total_len + 1) cast str;
    var buf_idx = 0;
    i = 0;

    while (i < parts_len) {
        var part = parts.get(i) cast str;
        var part_len = str_len(part);
        var k = 0;
        
        while (k < part_len) {
            buf[buf_idx] = part[k];
            buf_idx += 1;
            k += 1;
        }

        if (i < (parts_len -1)) {
            k = 0;
            while (k < repl_len) {
                buf[buf_idx] = repl[k];
                buf_idx += 1;
                k += 1;
            }
        }

        delete part;
        i += 1;
    }

    buf[buf_idx] = 0 cast char;

    parts.destroy();
    delete parts;

    return buf;
}