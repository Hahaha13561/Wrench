/# WRENCH STANDARD LIBRARY
    std/collections.wr
    Collections Library
#/

class List {
    var data;
    int capacity;
    int length;

    define init() {
        this.capacity = 10;
        this.length = 0;
        this.data = alloc(this.capacity * 8);
    }

    define push(var item) {
        if (this.length =? this.capacity) {
            this.capacity *= 2;
            this.data = realloc(this.data, this.capacity * 8);
        }

        this.data[this.length] = item;
        this.length += 1;
    }

    define get(int index) {
        if (index => this.length) {
            print("List Error: Index Out Of Bounds\n");
            trigger 99;
        }
        return this.data[index];
    }

    define set(int index, var item) {
        if (index => this.length) {
            print("List Error: Index Out Of Bounds\n");
            trigger 99;
        }
        this.data[index] = item;
    }

    define pop() {
        if (this.length =? 0) {
            print ("List Error: Cannot pop from empty list\n");
            trigger 99;
        }
        this.length -= 1;
        return this.data[this.length];
    }

    define clear() {
        delete this.data;
        this.capacity = 10;
        this.length = 0;
        this.data = alloc(this.capacity * 8);
    }

    define destroy() {
        delete this.data;
    }
}

class Map {
    List keys;
    List values;

    define init() {
        this.keys = new List();
        this.values = new List();
    }

    define set(str key, var value) {
        var i = 0;
        var len = this.keys.length;

        while (i < len) {
            if (this.keys.get(i) cast str =? key) {
                this.values.set(i, value);
                return 0;
            }
            i += 1;
        }

        this.keys.push(key);
        this.values.push(value);
        return 0;
    }

    define get(str key) {
        var i = 0;
        var len = this.keys.length;

        while (i < len) {
            if (this.keys.get(i) cast str =? key) {
                return this.values.get(i);
            }
            i += 1;
        }

        print("Map Error: Key Not Found -->");
        print(key);
        print("\n");
        trigger 99;
    }

    define has(str key) {
        var i = 0;
        var len = this.keys.length;

        while (i < len) {
            if (this.keys.get(i) cast str =? key) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    define destroy() {
        this.keys.destroy();
        free(this.keys);

        this.values.destroy();
        free(this.values);
    }
}

