include "std/collections.wr";

print("--- DYNAMIC LIST TEST ---\n");

var my_list = new List();

print("Pushing elements...\n");
my_list.push(10);
my_list.push(20);
my_list.push(30);

print("Element at index 1 (should be 20): ");
print_int(my_list.get(1) cast int);
print("\n");

print("List Length: ");
print_int(my_list.length);
print("\n");

print("Popped item (should be 30): ");
print_int(my_list.pop() cast int);
print("\n");

print("New Length: ");
print_int(my_list.length);
print("\n");

// Triggering Out of Bounds intentionally to test Memory Safety

my_list.destroy();
free(my_list);

print("--- TEST COMPLETE ---\n");

