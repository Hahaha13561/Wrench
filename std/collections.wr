include "std/collections.wr";
include "std/string.wr";

print("[*] Testing List...\n");
var my_list = new List();
my_list.push(10);
my_list.push(20);
my_list.push(30);
print("Popped from List (should be 30): ");
print_int(my_list.pop() cast int);
print("\n\n");
my_list.destroy();
free(my_list);

print("[*] Testing Map (Dictionary)...\n");
var sym_table = new Map();

sym_table.set("sayi", "int");
sym_table.set("metin", "string");
sym_table.set("aktif_mi", "bool");

print("Type of 'metin' (should be string): ");
print(sym_table.get("metin") cast str);
print("\n");

sym_table.set("sayi", "double");
print("Updated type of 'sayi' (should be double): ");
print(sym_table.get("sayi") cast str);
print("\n");

if (sym_table.has("aktif_mi")) {
    print("'aktif_mi' exists in Map!\n");
}

if (sym_table.has("olmayan_degisken") =? false) {
    print("'olmayan_degisken' does NOT exist! (Correct)\n");
}

sym_table.destroy();
free(sym_table);

print("\n--- ALL TESTS PASSED ---\n");
